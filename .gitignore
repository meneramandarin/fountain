.DS_Store
__pycache__/
*.py[cod]

.venv/

# SQLite runtime sidecars
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Raw scrape artifacts are large/generated. Rebuild or restore locally.
# Keep only the merged root-level canonical.db in Git.
data/databases/
data/databases/**/*.sqlite
data/databases/**/*.db
data/databases/**/*.sqlite-*
data/databases/**/*.db-*
data/media/
data/exports/*/
